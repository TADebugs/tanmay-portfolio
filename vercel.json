{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "tanmaydesai.site" }], "destination": "https://tanmaydesai.xyz/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/resume.pdf", "destination": "/resume" }
  ]
}
